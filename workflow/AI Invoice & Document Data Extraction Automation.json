    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nreturn items.map(item => {\n  const text = item.json.content?.parts?.[0]?.text || '';\n\n  const cleaned = text\n    .replace(/```json/gi, '')\n    .replace(/```/g, '')\n    .trim();\n\n  let result;\n\n  try {\n    result = JSON.parse(cleaned);\n  } catch (error) {\n    result = {\n      invoice_number: '',\n      invoice_date: '',\n      due_date: '',\n      vendor_name: '',\n      vendor_address: '',\n      customer_name: '',\n      customer_address: '',\n      subtotal: 0,\n      tax: 0,\n      total_amount: 0,\n      currency: '',\n      payment_terms: '',\n      items: [],\n      parsing_error: true,\n      parsing_error_message: error.message\n    };\n  }\n\n  return {\n    json: result\n  };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        800,
        -144
      ],
      "id": "f8d68c3b-df58-4f4d-998a-fd7ddbdb4739",
      "name": "Parse AI Invoice Result"
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nreturn items.map(item => {\n  const data = item.json;\n\n  const errors = [];\n\n  // Required fields\n  if (!data.invoice_number) errors.push('Missing invoice number');\n  if (!data.invoice_date) errors.push('Missing invoice date');\n  if (!data.vendor_name) errors.push('Missing vendor name');\n  if (!data.customer_name) errors.push('Missing customer name');\n\n  // Numeric validation\n  if (Number(data.subtotal) < 0) errors.push('Invalid subtotal');\n  if (Number(data.tax) < 0) errors.push('Invalid tax');\n  if (Number(data.total_amount) < 0) errors.push('Invalid total amount');\n\n  // Total calculation\n  const calculatedTotal =\n    Number(data.subtotal || 0) + Number(data.tax || 0);\n\n  const totalDifference =\n    Number(data.total_amount || 0) - calculatedTotal;\n\n  if (Math.abs(totalDifference) > 0.01) {\n    errors.push('Subtotal + tax does not match total amount');\n  }\n\n  const validationStatus =\n    errors.length === 0 ? 'Valid' : 'Invalid';\n\n  return {\n    json: {\n      ...data,\n      calculated_total: calculatedTotal,\n      total_difference: totalDifference,\n      validation_status: validationStatus,\n      validation_errors: errors\n    }\n  };\n});"
      },
      "type": "n8n-nodes-base.code",
